          {
            "name": "Fey Ancestry",
            "content": [
              {
                "type": "paragraph",
                "text": "You have advantage on saving throws made against being charmed, and magic can't put you to sleep."
              }
            ]
          },
          {
            "name": "Trance",
            "content": [
              {
                "type": "paragraph",
                "text": "Elves don't need sleep. Instead, they meditate deeply, remaining semiconscious, for 4 hours a day."
              },
              {
                "type": "note",
                "text": "During a trance, you can dream after a fashion; such dreams are actually mental exercises that have become reflexive through years of practice."
              }
            ]
          }
        ]
