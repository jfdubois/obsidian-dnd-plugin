# ──────────────────────────────────────────────────────────────
# Phase 5 — P5-T002: Environment variables for catalog-server
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# ──────────────────────────────────────────────────────────────

# Host port for the catalog server (maps to container port 8080).
CATALOG_PORT=8080

# Bind address for the catalog server (0.0.0.0 = all interfaces).
CATALOG_BIND_ADDRESS=0.0.0.0

# Host path to the generated catalog directory (mounted read-only).
# The catalog builder outputs a tree like catalog/v1/revisions/...
# which is served at the /catalog/ URL prefix by nginx.
# Default: ./catalog (relative to the docker-compose.yml location).
CATALOG_DATA_PATH=./catalog
