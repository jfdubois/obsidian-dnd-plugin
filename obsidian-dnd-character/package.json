{
  "name": "obsidian-dnd-character",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Obsidian D&D Character Manager — monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/run-workspaces.mjs build",
    "dev:plugin": "npm run dev --workspace=apps/obsidian-plugin",
    "build:catalog": "npm run build --workspace=apps/catalog-builder",
    "docker:catalog": "docker compose -f services/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
