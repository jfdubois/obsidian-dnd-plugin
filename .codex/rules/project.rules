# Project command policy for actions that execute outside the workspace sandbox.
# These narrow allow rules support unattended phase execution even when the active
# Codex session uses approval_policy = "never". Project instructions and the phase
# skill still control when each command may be used.

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "rev-parse", "branch", "remote", "rev-list"]],
    decision = "allow",
    justification = "Read-only Git inspection is allowed.",
    match = [
        "git status --short",
        "git diff --check",
        "git diff --cached --check",
        "git log -10 --oneline",
        "git rev-parse HEAD",
        "git branch --show-current",
        "git remote -v",
        "git rev-list --left-right --count origin/dev...dev",
    ],
)

prefix_rule(
    pattern = ["git", "fetch", "origin", "dev"],
    decision = "allow",
    justification = "Allow the phase parent to refresh origin/dev during mandatory preflight without prompting.",
    match = ["git fetch origin dev"],
)

prefix_rule(
    pattern = ["git", "add", "-A"],
    decision = "allow",
    justification = "Allow the phase parent to stage the already-reviewed active task or gate diff.",
    match = ["git add -A"],
)

prefix_rule(
    pattern = ["git", "commit", "-m"],
    decision = "allow",
    justification = "Allow the phase parent to create the required atomic task or phase-gate commit after validation and staged-diff review.",
    match = [
        "git commit -m chore(project): complete P3-T007 -m P3-T007",
        "git commit -m chore(project): complete phase 3 gate -m Phase 3 gate",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "dev"],
    decision = "allow",
    justification = "Allow the phase parent to push validated task and gate commits only to origin/dev.",
    match = ["git push origin dev"],
)

prefix_rule(
    pattern = ["git", ["reset", "clean", "restore", "stash", "rebase", "merge", "cherry-pick", "revert", "checkout", "switch", "tag"]],
    decision = "forbidden",
    justification = "Destructive, branch-changing, history-rewriting, and release Git actions are prohibited. Preserve the current tree and report the blocker instead.",
    match = [
        "git reset --hard HEAD",
        "git clean -fd",
        "git restore .",
        "git stash",
        "git rebase origin/dev",
        "git merge main",
        "git cherry-pick abc123",
        "git revert abc123",
        "git checkout main",
        "git switch main",
        "git tag v1.0.0",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "forbidden",
    justification = "Amending task or gate commits is prohibited; create a new explicit repair commit instead.",
    match = ["git commit --amend"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force-push is prohibited. Stop and report the synchronization problem.",
    match = [
        "git push --force origin dev",
        "git push -f origin dev",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "forbidden",
    justification = "Automated agents may not push to main. An explicit release instruction is required outside this workflow.",
    match = ["git push origin main"],
)
